<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <!-- x64 on Windows (unchanged); macOS builds osx-arm64 (AnyCPU IL + an arm64 host). -->
    <PlatformTarget Condition="'$(OS)' == 'Windows_NT'">x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same test stack as CoreVideo Pro's MediaCore.Tests. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <!-- Lifted Pro tests of the Windows DPAPI protector (kept verbatim): DPAPI
         does not exist off Windows. macOS covers the same contract with
         KeychainSecretProtectorTests and the [MacOnlyFact] Keychain tests. -->
    <Compile Remove="Lifted\DpapiSecretProtectorTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreVideoEdge.Core\CoreVideoEdge.Core.csproj" />
    <!-- View-model tests (what JSON each operator action sends). -->
    <ProjectReference Include="..\CoreVideoEdge.Desktop\CoreVideoEdge.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The token dictionary the app ships, contrast-checked pair by pair. -->
    <None Include="..\CoreVideoEdge.Desktop\Theme\Tokens.axaml" Link="Fixtures\Tokens.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\screenshots\fixtures\state-in-meeting.json" Link="Fixtures\state-in-meeting.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\package-macos-app.sh" Link="Fixtures\package-macos-app.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\screenshots\fixtures\state-recording.json" Link="Fixtures\state-recording.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
