<!--
  Lucide icons (ISC licence, lucide.dev), 24-unit grid, drawn as STROKES at
  1.75 by the Icon style (Path.icon). One set, one weight; no emoji or glyphs.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
