<Window x:Class="CoreVideoEdge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreVideo Edge" Width="1280" Height="800" MinWidth="980" MinHeight="600"
        Background="{StaticResource Ink}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Header -->
    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14" LastChildFill="False">
      <TextBlock Text="CoreVideo Edge" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="NodeNameText" Foreground="{StaticResource Muted}" Margin="12,4,0,0" VerticalAlignment="Center"/>
      <Border x:Name="FakeBadge" Visibility="Collapsed" Background="{StaticResource Warn}" CornerRadius="3"
              Padding="8,2" Margin="12,2,0,0" VerticalAlignment="Center">
        <TextBlock Text="SYNTHETIC MEETING (fake engine)" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="Bold"/>
      </Border>
      <Border x:Name="RecBadge" DockPanel.Dock="Right" Visibility="Collapsed" Background="{StaticResource Live}"
              CornerRadius="3" Padding="10,3" VerticalAlignment="Center">
        <TextBlock x:Name="RecBadgeText" Text="REC" FontWeight="Bold"/>
      </Border>
    </DockPanel>

    <!-- Left: account, meeting, record -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="ZOOM ACCOUNT"/>
            <TextBlock x:Name="AccountText" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SignInButton" Content="Sign in with Zoom" Click="SignIn_Click"/>
              <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="MEETING"/>
            <TextBlock Text="Zoom meeting link (with its pwd=) or meeting ID" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="MeetingBox" AutomationProperties.Name="Zoom meeting link"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="JoinButton" Content="Join" Click="Join_Click"/>
              <Button x:Name="LeaveButton" Content="Leave" Click="Leave_Click"/>
            </StackPanel>
            <Button x:Name="EndOtherButton" Content="Join and end my other Zoom session" Visibility="Collapsed"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="JoinEndOther_Click"/>
            <TextBlock x:Name="PhaseText" Margin="0,10,0,0" FontWeight="SemiBold"/>
            <TextBlock x:Name="SelfText" Style="{StaticResource Status}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="RawMediaText" Style="{StaticResource Status}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="MeetingErrorText" Style="{StaticResource Status}" Foreground="{StaticResource Live}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="EngineWarningText" Style="{StaticResource Status}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="ISO RECORD"/>
            <TextBlock Text="Record folder" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" x:Name="BrowseButton"/>
              <TextBox x:Name="FolderBox" AutomationProperties.Name="Record folder" LostFocus="Folder_LostFocus"/>
            </DockPanel>
            <TextBlock Text="File prefix" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,4"/>
            <TextBox x:Name="PrefixBox" AutomationProperties.Name="File prefix" LostFocus="Prefix_LostFocus" Width="160" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="RecordButton" Content="Start recording" Click="Record_Click"/>
              <Button x:Name="StopButton" Content="Stop recording" Click="Stop_Click"/>
            </StackPanel>
            <TextBlock x:Name="RecordStatusText" Style="{StaticResource Status}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="RecordWarningText" Style="{StaticResource Status}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
              <Hyperlink x:Name="SessionLink" Click="SessionLink_Click" Foreground="{StaticResource Accent}">
                <Run x:Name="SessionLinkText"/>
              </Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>

        <TextBlock x:Name="NoteText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                   Text="Live relay to CoreVideo Pro is out of scope for v1: the ISO files above are the hand-off."/>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: sources and ISO health -->
    <Grid Grid.Row="1" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="2*"/>
      </Grid.RowDefinitions>

      <Border Style="{StaticResource Card}" Grid.Row="0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Heading}" Text="SOURCES" Margin="0"/>
            <TextBlock x:Name="SubscribedText" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0"/>
          </DockPanel>
          <TextBlock x:Name="SourcesHint" Style="{StaticResource Status}" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ListView x:Name="SourcesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Participant" Width="230" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Video" Width="60" DisplayMemberBinding="{Binding VideoText}"/>
                <GridViewColumn Header="Talking" Width="64" DisplayMemberBinding="{Binding TalkingText}"/>
                <GridViewColumn Header="Received" Width="150" DisplayMemberBinding="{Binding ReceivedText}"/>
                <GridViewColumn Header="Subscribe" Width="80">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Subscribed, Mode=OneWay}" IsEnabled="{Binding CanSubscribe}"
                                Click="Subscribe_Click" AutomationProperties.Name="{Binding SubscribeLabel}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="ISO" Width="60">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Iso, Mode=OneWay}" IsEnabled="{Binding CanIso}"
                                Click="Iso_Click" AutomationProperties.Name="{Binding IsoLabel}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" x:Name="HealthHeading" Text="ISO HEALTH"/>
          <ListView x:Name="HealthList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="ISO" Width="48" DisplayMemberBinding="{Binding IndexText}"/>
                <GridViewColumn Header="Source" Width="150" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="State" Width="80" DisplayMemberBinding="{Binding State}"/>
                <GridViewColumn Header="Frames" Width="74" DisplayMemberBinding="{Binding FramesText}"/>
                <GridViewColumn Header="Audio" Width="84" DisplayMemberBinding="{Binding AudioText}"/>
                <GridViewColumn Header="Lost v/a" Width="70" DisplayMemberBinding="{Binding LostText}"/>
                <GridViewColumn Header="Encoder" Width="76" DisplayMemberBinding="{Binding EncoderText}"/>
                <GridViewColumn Header="Warning" Width="220">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
